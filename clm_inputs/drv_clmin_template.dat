!=========================================================================
! drv_clmin.dat — Phase 1: Configuration-only ET improvements
!
! Changes from standard:
!   forc_hgt_u  10.0 → 30.0   (reduces aerodynamic resistance over tall vegetation)
!   forc_hgt_t   2.0 → 30.0   (consistent forcing height for T and q)
!   forc_hgt_q   2.0 → 30.0
!   dewmx        0.1 → 0.2    (doubles canopy water storage capacity)
!
! See forcing_height_displacement_summary.md for rationale on 30m height.
! No code changes required — works with any ParFlow version that has CLM.
!=========================================================================
!
maxt           1                                     Maximum tiles per grid
mina           0.05                                  Min grid area for tile (%)
udef           -9999.                                Undefined value
vclass         2                                     Vegetation Classification Scheme (1=UMD,2=IGBP)
!
vegtf          drv_vegm.dat                          Vegetation Tile Specification File
vegpf          drv_vegp.dat                          Vegetation Type Parameter
metf1d         forcing.1hr.txt                       Meteorologic input file
outf1d         clm.output.txt                        CLM output file
poutf1d        clm.para.out.dat                      CLM 1D Parameter Output File
rstf           clm.rst.                              CLM active restart file
!
startcode      2                                     1=restart file,2=defined
!
sss            00                                    Starting Second
smn            00                                    Starting Minute
shr            00                                    Starting Hour
sda            01                                    Starting Day
smo            10                                    Starting Month
syr            2014                                  Starting Year
!
ess            00                                    Ending Second
emn            00                                    Ending Minute
ehr            00                                    Ending Hour
eda            01                                    Ending Day
emo            10                                    Ending Month
eyr            2015                                  Ending Year
!
clm_ic         2                                     1=restart file,2=defined
               CLM Initial Condition Source
!
t_ini          285.                                  Initial temperature [K]
h2osno_ini     0.                                    Initial snow cover [mm]
sw_ini         0.5                                   Initial soil water fraction
!
surfind        2                                     Number of surface diagnostic variables
soilind        1                                     Number of soil layer diagnostic variables
snowind        0                                     Number of snow layer diagnostic variables
!
!===CLM Forcing parameters — CHANGED for Phase 1
!
forc_hgt_u     30.0                                  Observational height of wind [m] (was 10.0)
forc_hgt_t     30.0                                  Observational height of temperature [m] (was 2.0)
forc_hgt_q     30.0                                  Observational height of humidity [m] (was 2.0)
!
!===CLM Vegetation parameters — CHANGED for Phase 1
!
dewmx          0.2                                   Maximum allowed dew [mm] (was 0.1)
qflx_tran_vegmx-9999.0                              Maximum possible transpiration rate [mm/s]
rootfr         -9999.0                               Root Fraction (depth average)
!
!===Roughness lengths
!
zlnd           0.01                                  Roughness length for soil [m]
zsno           0.0024                                Roughness length for snow [m]
csoilc         0.0025                                Drag coefficient for soil under canopy [-]
!
!=== Numerical finite-difference parameters
!
capr           0.34                                  Tuning factor to turn first layer T into surface T
cnfac          0.5                                   Crank Nicholson factor between 0 and 1
smpmin         -1.e8                                 Restriction for min of soil poten. (mm)
ssi            0.033                                 Irreducible water saturation of snow
wimp           0.05                                  Water impremeable if porosity < wimp
